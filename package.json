{
  "name": "@hasna/contracts",
  "version": "1.0.0-rc.1",
  "description": "Side-effect-free schemas, inferred types, and validators for Hasna contracts.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hasna/contracts.git"
  },
  "homepage": "https://github.com/hasna/contracts",
  "bugs": {
    "url": "https://github.com/hasna/contracts/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "workspaces": [
    "packages/*"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas": {
      "types": "./dist/schemas.d.ts",
      "import": "./dist/schemas.js"
    },
    "./validators": {
      "types": "./dist/validators.d.ts",
      "import": "./dist/validators.js"
    },
    "./primitives": {
      "types": "./dist/primitives.d.ts",
      "import": "./dist/primitives.js"
    },
    "./json-schemas/*": "./schemas/v1/*"
  },
  "files": [
    "dist",
    "schemas/v1",
    "src/hasna.contract.schema.json",
    "fixtures/compatibility/*.json",
    "docs/CORE_RELEASE_CANDIDATE.md",
    "docs/release",
    "hasna.contract.json",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun run schemas:check && rm -rf dist && bun build src/index.ts src/schemas.ts src/validators.ts src/primitives.ts --root src --outdir dist --target bun --packages external && tsc -p tsconfig.core.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test --timeout 120000",
    "lint": "tsc --noEmit",
    "conformance": "bun run src/cli/index.ts conformance examples",
    "verify:release": "rm -rf dist && bun run schemas:check && bun run typecheck && bun run test && bun run build && bun run smoke:dist && bun run matrix:compile && bun run candidate:verify",
    "smoke:dist": "bun scripts/smoke-dist.ts",
    "matrix:compile": "bun scripts/compile-reverse-dependency-matrix.ts",
    "candidate:build": "bun scripts/build-release-candidate.ts",
    "candidate:verify": "bun scripts/build-release-candidate.ts --check",
    "schemas:generate": "bun scripts/generate-core-schemas.ts",
    "schemas:check": "bun scripts/generate-core-schemas.ts --check",
    "todos:generate": "bun scripts/generate-todos-contract.ts",
    "todos:check": "bun scripts/generate-todos-contract.ts --check",
    "todos:hygiene": "bun scripts/check-todos-text-hygiene.ts",
    "dev:cli": "bun run --filter @hasna/contracts-cli dev",
    "prepack": "bun run schemas:check && bun run build && bun run smoke:dist",
    "prepublishOnly": "bun run verify:release",
    "scan:artifact": "bun scripts/scan-artifact.ts"
  },
  "keywords": [
    "contracts",
    "schemas",
    "agents",
    "zod",
    "json-schema",
    "hasna"
  ],
  "engines": {
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bun": "^1.2.4",
    "@types/pg": "^8.11.10",
    "commander": "^13.1.0",
    "pg": "^8.13.1",
    "typescript": "^5.7.3",
    "zod-to-json-schema": "^3.25.1"
  }
}
