{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "hasna.contracts.tenant_context.v1",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "hasna.contracts.tenant_context.v1"
    },
    "tenantId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "principal": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string",
          "const": "hasna.contracts.principal.v1"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "kind": {
          "type": "string",
          "enum": [
            "human",
            "service",
            "agent",
            "system"
          ]
        },
        "tenantId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]*$"
          },
          "default": []
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]*$"
          },
          "default": []
        },
        "claims": {
          "type": "object",
          "additionalProperties": {}
        }
      },
      "required": [
        "schema",
        "id",
        "kind"
      ],
      "additionalProperties": false
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "traceparent": {
      "type": "string",
      "pattern": "^[\\da-f]{2}-[\\da-f]{32}-[\\da-f]{16}-[\\da-f]{2}$"
    }
  },
  "required": [
    "schema",
    "tenantId",
    "principal",
    "requestId"
  ],
  "additionalProperties": false,
  "x-hasna-runtime-validator": "validateCoreContract"
}
