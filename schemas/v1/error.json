{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "hasna.contracts.error.v1",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "hasna.contracts.error.v1"
    },
    "code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]*$"
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "enum": [
        "validation",
        "authentication",
        "authorization",
        "not_found",
        "conflict",
        "rate_limit",
        "upstream",
        "internal"
      ]
    },
    "retryable": {
      "type": "boolean"
    },
    "details": {
      "type": "object",
      "additionalProperties": {}
    },
    "correlationId": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema",
    "code",
    "message",
    "category",
    "retryable"
  ],
  "additionalProperties": false,
  "x-hasna-runtime-validator": "validateCoreContract"
}
