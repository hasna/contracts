{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "hasna.contracts.principal.v1",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "hasna.contracts.principal.v1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "kind": {
      "type": "string",
      "enum": [
        "human",
        "service",
        "agent",
        "system"
      ]
    },
    "tenantId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]*$"
      },
      "default": []
    },
    "scopes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]*$"
      },
      "default": []
    },
    "claims": {
      "type": "object",
      "additionalProperties": {}
    }
  },
  "required": [
    "schema",
    "id",
    "kind"
  ],
  "additionalProperties": false,
  "x-hasna-runtime-validator": "validateCoreContract"
}
