{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "hasna.contracts.secret_ref.v1",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "hasna.contracts.secret_ref.v1"
    },
    "uri": {
      "type": "string",
      "pattern": "^(?:secret|vault|aws-sm|gcp-sm|azure-kv):\\/\\/[A-Za-z0-9][A-Za-z0-9._~!$&'()*+,;=:@/-]*$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    }
  },
  "required": [
    "schema",
    "uri"
  ],
  "additionalProperties": false,
  "x-hasna-runtime-validator": "validateCoreContract"
}
