{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "hasna.contracts.compatibility.v1",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "hasna.contracts.compatibility.v1"
    },
    "contract": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]*$"
    },
    "currentVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "minimumVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "supportedVersions": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
      },
      "minItems": 1
    },
    "strategy": {
      "type": "string",
      "enum": [
        "exact",
        "additive"
      ]
    }
  },
  "required": [
    "schema",
    "contract",
    "currentVersion",
    "minimumVersion",
    "supportedVersions",
    "strategy"
  ],
  "additionalProperties": false,
  "x-hasna-runtime-validator": "validateCoreContract"
}
